{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Locora",
  "version": "0.1.0",
  "identifier": "cloud.locora",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../ui", "wait": false },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../ui" }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Locora",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: locora: http://locora.localhost",
        "media-src": "'self' locora: http://locora.localhost blob:",
        "frame-src": "locora: http://locora.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost locora: http://locora.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Gedächtnispaläste, offline",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
